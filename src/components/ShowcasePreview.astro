          <div class="bg-white dark:bg-neutral-950 rounded-[24px] p-4 space-y-3 border border-[#EAEAE4] dark:border-white/5">
            <div class="flex items-center justify-between border-b border-[#EAEAE4] dark:border-white/10 pb-2">
