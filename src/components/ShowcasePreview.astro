            </div>
            <span class="flex items-center gap-1 text-[10px] text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              WhatsApp Webhook Activo
            </span>
          </div>

          <!-- Conversación Simulada -->
          <div class="space-y-2.5 text-[11px] font-sans">
            <div class="p-2.5 rounded-lg bg-white/5 border border-white/5">
              <span class="text-neutral-400 text-[9px] uppercase font-mono block mb-1">Cliente entrante:</span>
              <p class="text-neutral-200">"Hola, ¿cuánto cuesta desarrollar una landing para una inmobiliaria y qué incluye?"</p>
