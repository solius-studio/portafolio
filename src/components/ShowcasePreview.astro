        <div class="rounded-2xl border border-[#EAEAE4] dark:border-white/10 bg-[#121316] text-white p-5 shadow-2xl space-y-4 font-mono text-xs">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div class="flex items-center gap-2">
              <IconAI class="w-4 h-4 text-red-500" />
