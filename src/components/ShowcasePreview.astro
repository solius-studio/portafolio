---
import IconArrowRight from './icons/IconArrowRight.astro';
import IconLegal from './icons/IconLegal.astro';
import IconGastronomy from './icons/IconGastronomy.astro';
import IconAI from './icons/IconAI.astro';
import IconCheck from './icons/IconCheck.astro';
import IconSparkle from './icons/IconSparkle.astro';
---

<section id="proyectos" class="py-24 px-4 sm:px-6 lg:px-10 max-w-[1240px] mx-auto border-t border-[#EAEAE4] dark:border-white/10 relative overflow-hidden">
  
  <!-- Encabezado de la Sección Portfolio + Controles del Carrusel -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#E58B72] dark:bg-red-500 animate-pulse"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-[#8A3D28] dark:text-red-400 font-semibold">02 // Showcase Interactivo</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#252A29] dark:text-white tracking-tight leading-[1.15]">
        Demos y Prototipos en Vivo.
      </h2>
      <p class="mt-3 text-sm text-[#252A29]/75 dark:text-neutral-400 max-w-lg leading-relaxed">
        Deslizá para explorar cada solución: interfaces reales para celulares y computadoras, preparadas para generar confianza inmediata en tus clientes.
      </p>
    </div>

    <!-- Controles del Carrusel (Flechas + Indicador de diapositiva) -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-neutral-900 text-xs font-mono font-medium text-[#252A29] dark:text-neutral-300">
        <span id="carousel-current">1</span>
        <span class="text-[#252A29]/40 dark:text-neutral-500">/</span>
        <span>3</span>
      </div>

      <button 
        id="carousel-prev" 
        type="button"
        aria-label="Proyecto anterior"
        class="w-10 h-10 rounded-full border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-neutral-900 flex items-center justify-center text-[#252A29] dark:text-white hover:bg-[#8A3D28] hover:text-white dark:hover:bg-red-600 transition-all duration-200 shadow-sm active:scale-95"
      >
        <svg class="w-4 h-4 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>

      <button 
        id="carousel-next" 
        type="button"
        aria-label="Siguiente proyecto"
        class="w-10 h-10 rounded-full border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-neutral-900 flex items-center justify-center text-[#252A29] dark:text-white hover:bg-[#8A3D28] hover:text-white dark:hover:bg-red-600 transition-all duration-200 shadow-sm active:scale-95"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>

  <!-- Pestañas de Navegación Rápida de Proyectos -->
  <div class="flex items-center gap-2 mb-8 overflow-x-auto pb-2 scrollbar-none">
    <button class="project-pill active px-4 py-2 rounded-full text-xs font-medium transition-all duration-200 whitespace-nowrap bg-[#8A3D28] dark:bg-red-600 text-white shadow-sm" data-slide="0">
      01. LexVanguard (Estudio Jurídico)
    </button>
    <button class="project-pill px-4 py-2 rounded-full text-xs font-medium transition-all duration-200 whitespace-nowrap bg-white dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-neutral-300 hover:border-[#8A3D28] dark:hover:border-red-500" data-slide="1">
      02. Aura Bistro (Comercio & QR)
    </button>
    <button class="project-pill px-4 py-2 rounded-full text-xs font-medium transition-all duration-200 whitespace-nowrap bg-white dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-neutral-300 hover:border-[#8A3D28] dark:hover:border-red-500" data-slide="2">
      03. NovaDesk AI (Agente Autónomo)
    </button>
  </div>

  <!-- Contenedor del Carrusel (Swipeable + Scroll Snap) -->
  <div 
    id="showcase-carousel" 
    class="flex gap-6 overflow-x-auto carousel-snap pb-6 scrollbar-none transition-all duration-300"
  >

    <!-- SLIDE 1: LexVanguard Abogados -->
    <div class="carousel-snap-item min-w-full lg:min-w-[100%] rounded-3xl border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-[#0E0E12] p-6 sm:p-10 shadow-md dark:shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Detalle Editorial -->
      <div class="lg:col-span-6 space-y-6">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-[#8A3D28]/10 dark:bg-red-950/60 text-[#8A3D28] dark:text-red-400 border border-[#8A3D28]/20 dark:border-red-800/40 text-xs font-mono font-semibold uppercase">
            Estudios Jurídicos
          </span>
          <span class="text-xs font-mono text-[#252A29]/50 dark:text-neutral-500">Caso de Estudio 01</span>
        </div>

        <div>
          <h3 class="text-2xl sm:text-3xl font-bold text-[#252A29] dark:text-white tracking-tight">
            LexVanguard — Firma Legal & Consultoría
          </h3>
          <p class="mt-3 text-sm text-[#252A29]/75 dark:text-neutral-400 leading-relaxed">
            Plataforma institucional sobria diseñada para despachos de abogados que buscan transmitir autoridad instantánea y filtrar consultas spam antes de la primera llamada.
          </p>
        </div>

        <!-- Métricas Clave -->
        <div class="grid grid-cols-3 gap-3 p-4 rounded-2xl bg-[#F8F8F5] dark:bg-neutral-950/80 border border-[#EAEAE4] dark:border-white/5">
          <div>
