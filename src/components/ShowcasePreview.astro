---
import IconLegal from './icons/IconLegal.astro';
import IconGastronomy from './icons/IconGastronomy.astro';
import IconAI from './icons/IconAI.astro';
import IconArrowRight from './icons/IconArrowRight.astro';

const projects = [
  {
    title: "LexVanguard Abogados",
    sector: "Estudio Jurídico & Asesoría Corporativa",
    problem: "Demasiadas consultas informales por mensaje que consumían horas de los socios sin traducirse en honorarios.",
    solution: "Portal institucional con triaje inteligente: califica el caso en 3 preguntas antes de agendar la consulta con el especialista.",
    deliverables: ["Intake inteligente de clientes", "Carga en 0.4 segundos", "Pasarela de cobro de consultas"],
    icon: IconLegal,
    slug: "lexvanguard"
  },
  {
    title: "Aura Bistro & Bar",
    sector: "Gastronomía & Comercios de Cercanía",
    problem: "Comisiones del 25% al 30% en plataformas de delivery y cartas en PDF pesadas que los clientes no querían descargar.",
    solution: "Menú digital interactivo ultraliviano con selector de mesa y envío de comandas estructuradas directo al WhatsApp de cocina.",
    deliverables: ["0% comisiones a apps", "Menú QR instantáneo", "Pedidos directos a WhatsApp"],
    icon: IconGastronomy,
    slug: "aura-bistro"
  },
  {
    title: "NovaDesk AI Assistant",
    sector: "Automatización & Atención al Cliente",
    problem: "Prospectos calificados que escribían fuera de horario comercial y se iban con la competencia por falta de respuesta.",
    solution: "Agente autónomo integrado a WhatsApp que responde preguntas de stock, cotiza servicios y reserva turnos las 24 horas.",
    deliverables: ["Disponibilidad 24/7 sin fallas", "Conexión a Notion/Google Sheets", "Derivación a humanos en casos VIP"],
    icon: IconAI,
    slug: "novadesk-ai"
  }
];
---

<section id="proyectos" class="py-24 px-6 lg:px-12 max-w-7xl mx-auto border-t border-white/[0.06]">
  
  <!-- Encabezado de Sección -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-red-600"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-neutral-400">02 // Casos de Estudio & Prototipos</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-white tracking-tight leading-[1.15]">
        Resultados tangibles para <br class="hidden sm:inline" />
        negocios en el mundo real.
      </h2>
    </div>
    <p class="text-sm text-neutral-400 max-w-md leading-relaxed">
      Proyectos estructurados para resolver problemas comerciales concretos: tiempos de carga, fugas de comisiones y atención sin demoras.
    </p>
  </div>

  <!-- Grilla de Casos de Estudio -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    {projects.map((item) => {
      const IconComponent = item.icon;
      return (
        <div class="rounded-xl bg-[#0c0c0f] border border-white/[0.08] hover:border-white/20 p-8 flex flex-col justify-between transition-all duration-300 group">
          <div>
            <!-- Cabecera -->
            <div class="flex items-center justify-between mb-6">
              <div class="w-10 h-10 rounded-lg bg-white/[0.04] border border-white/10 flex items-center justify-center text-white">
                <IconComponent class="w-5 h-5 text-neutral-300" />
              </div>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-white/[0.03] border border-white/10 text-neutral-300">
                Caso de Muestra
              </span>
            </div>

            <span class="text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-2">
              {item.sector}
            </span>
            <h3 class="text-2xl font-semibold text-white tracking-tight mb-4">
              {item.title}
            </h3>

            <!-- Problema y Solución -->
            <div class="space-y-3 mb-6 text-xs text-neutral-400 leading-relaxed">
              <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                <strong class="text-neutral-300 font-mono block mb-1">EL DESAFÍO:</strong>
                {item.problem}
              </div>
              <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                <strong class="text-neutral-300 font-mono block mb-1">LA SOLUCIÓN:</strong>
                {item.solution}
              </div>
            </div>

            <!-- Entregables Técnicos -->
            <ul class="space-y-1.5 mb-8 text-xs font-mono text-neutral-300">
              {item.deliverables.map(del => (
                <li class="flex items-center gap-2">
                  <span class="text-red-500">•</span>
                  <span>{del}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Acción -->
          <a 
            href="#contacto" 
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-lg bg-white/[0.04] hover:bg-white text-neutral-200 hover:text-neutral-950 text-xs font-medium transition-all duration-200 border border-white/10 group/btn"
          >
            <span>Consultar Solución Similar</span>
            <IconArrowRight class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform" />
          </a>
        </div>
      );
    })}
  </div>

  <!-- Franja de Diagnóstico Directo -->
  <div class="mt-12 p-6 rounded-xl border border-white/[0.08] bg-[#0c0c0f] flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <p class="text-sm text-neutral-300">
        ¿Quieres una auditoría sin costo de la web o el flujo de atención de tu negocio?
      </p>
    </div>
    <a 
      href="#contacto" 
      class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-white hover:text-neutral-300 transition-colors whitespace-nowrap"
    >
      <span>Solicitar diagnóstico gratuito</span>
      <IconArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>

</section>
