            <p class="text-[10px] text-[#252A29]/60 dark:text-neutral-400 uppercase tracking-wider font-mono">Carga Celular</p>
          </div>
          <div>
            <p class="text-lg font-bold text-[#252A29] dark:text-white">+65%</p>
            <p class="text-[10px] text-[#252A29]/60 dark:text-neutral-400 uppercase tracking-wider font-mono">Leads Calificados</p>
