        </div>

        <div class="pt-2">
          <a 
            href="#contacto" 
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#252A29] dark:bg-white text-white dark:text-black text-xs font-bold tracking-wide hover:bg-[#8A3D28] dark:hover:bg-red-500 dark:hover:text-white transition-all shadow-sm"
