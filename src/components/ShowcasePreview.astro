              <span>➔ Lead Calificado: Rubro Inmobiliario</span>
              <span>Alerta enviada a WhatsApp del dueño ✓</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>

</section>

<script>
  // Lógica del Carrusel Interactivo
  const carousel = document.getElementById('showcase-carousel');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const currentIndicator = document.getElementById('carousel-current');
  const pills = document.querySelectorAll('.project-pill');

  let activeIndex = 0;
  const totalSlides = 3;

  function updateCarousel(index: number) {
    if (!carousel) return;
    activeIndex = Math.max(0, Math.min(index, totalSlides - 1));
    const slideWidth = carousel.clientWidth;
    carousel.scrollTo({
      left: activeIndex * slideWidth,
      behavior: 'smooth'
    });

    if (currentIndicator) {
      currentIndicator.textContent = String(activeIndex + 1);
    }

    pills.forEach((pill, i) => {
      if (i === activeIndex) {
        pill.classList.remove('bg-white', 'dark:bg-neutral-900', 'border', 'border-[#EAEAE4]', 'dark:border-white/10', 'text-[#252A29]', 'dark:text-neutral-300');
        pill.classList.add('bg-[#8A3D28]', 'dark:bg-red-600', 'text-white');
      } else {
        pill.classList.remove('bg-[#8A3D28]', 'dark:bg-red-600', 'text-white');
        pill.classList.add('bg-white', 'dark:bg-neutral-900', 'border', 'border-[#EAEAE4]', 'dark:border-white/10', 'text-[#252A29]', 'dark:text-neutral-300');
      }
    });
  }

  if (prevBtn && nextBtn && carousel) {
    prevBtn.addEventListener('click', () => updateCarousel(activeIndex - 1));
    nextBtn.addEventListener('click', () => updateCarousel(activeIndex + 1));

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const slideIdx = Number(pill.getAttribute('data-slide'));
        updateCarousel(slideIdx);
      });
    });

    // Detectar scroll táctil en smartphones
    carousel.addEventListener('scroll', () => {
      const scrollPos = carousel.scrollLeft;
      const slideWidth = carousel.clientWidth;
      const detectedIndex = Math.round(scrollPos / slideWidth);
      if (detectedIndex !== activeIndex && detectedIndex >= 0 && detectedIndex < totalSlides) {
        activeIndex = detectedIndex;
        if (currentIndicator) currentIndicator.textContent = String(activeIndex + 1);
        pills.forEach((pill, i) => {
          if (i === activeIndex) {
            pill.classList.remove('bg-white', 'dark:bg-neutral-900', 'border', 'border-[#EAEAE4]', 'dark:border-white/10', 'text-[#252A29]', 'dark:text-neutral-300');
            pill.classList.add('bg-[#8A3D28]', 'dark:bg-red-600', 'text-white');
          } else {
            pill.classList.remove('bg-[#8A3D28]', 'dark:bg-red-600', 'text-white');
            pill.classList.add('bg-white', 'dark:bg-neutral-900', 'border', 'border-[#EAEAE4]', 'dark:border-white/10', 'text-[#252A29]', 'dark:text-neutral-300');
          }
        });
      }
    }, { passive: true });
  }
</script>
