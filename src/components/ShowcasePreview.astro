        </div>

        <!-- Características Resueltas -->
        <div class="space-y-2 text-xs text-[#252A29]/80 dark:text-neutral-300">
          <div class="flex items-center gap-2">
            <IconCheck class="w-4 h-4 text-[#8A3D28] dark:text-red-500 shrink-0" />
