      </div>

      <!-- Mockup Visual Interactivo (Laptop Frame) -->
      <div class="lg:col-span-6">
        <div class="rounded-2xl border border-[#EAEAE4] dark:border-white/10 bg-[#F8F8F5] dark:bg-[#070709] p-3 shadow-xl relative overflow-hidden group">
          <!-- Barra de navegación del navegador simulado -->
          <div class="flex items-center justify-between px-3 py-2 border-b border-[#EAEAE4] dark:border-white/10 mb-3 bg-white dark:bg-neutral-900 rounded-lg">
            <div class="flex items-center gap-1.5">
