          </div>

          <!-- Contenido visual del sitio simulado -->
          <div class="p-6 bg-white dark:bg-neutral-950 rounded-xl border border-[#EAEAE4] dark:border-white/5 space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
