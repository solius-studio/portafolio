---
const steps = [
  {
    num: "01",
    title: "Diagnóstico",
    description: "Analizamos tu modelo de negocio, tus clientes y los puntos donde perdés ventas o tiempo operativo."
  },
  {
    num: "02",
    title: "Diseño",
    description: "Prototipamos la experiencia visual y funcional, pensada para el usuario que navega desde el celular."
  },
  {
    num: "03",
    title: "Desarrollo",
    description: "Programamos código limpio, implementamos los agentes inteligentes y conectamos WhatsApp y calendarios."
  },
  {
    num: "04",
    title: "Lanzamiento",
    description: "Desplegamos en servidores rápidos, optimizamos para Google y te enseñamos a monitorear los resultados."
  }
];
---

<section id="metodo" class="py-24 px-6 border-t border-white/[0.06]">
  <div class="max-w-[1200px] mx-auto">

    <div class="max-w-lg mb-16">
      <p class="text-[13px] text-neutral-500 mb-3 font-mono tracking-wide">Método de trabajo</p>
      <h2 class="font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-[-0.03em] text-white leading-[1.15]">
        Cómo llegamos del diagnóstico a la entrega
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border-t border-white/[0.06]">
      {steps.map((step, i) => (
        <div class={`py-8 ${i < 3 ? 'lg:border-r lg:border-white/[0.06]' : ''} ${i < 3 ? 'lg:pr-8' : ''} ${i > 0 ? 'lg:pl-8' : ''} border-b md:border-b-0 border-white/[0.06] last:border-b-0`}>
          <span class="font-mono text-[13px] text-neutral-600 block mb-4">{step.num}</span>
          <h3 class="font-display text-lg font-semibold text-white tracking-tight mb-2">
            {step.title}
          </h3>
          <p class="text-[13px] text-neutral-500 leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
