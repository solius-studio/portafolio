---
interface Props {
  class?: string;
}

const { class: className = "w-6 h-6" } = Astro.props;
---

<svg 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <!-- Base de la bolsa geométrica -->
  <path 
    d="M4.5 8.5L3.5 19C3.3 20.2 4.2 21.2 5.5 21.2H18.5C19.8 21.2 20.7 20.2 20.5 19L19.5 8.5H4.5Z" 
    stroke="currentColor" 
    stroke-width="1.5" 
    stroke-linejoin="round"
    stroke-opacity="0.85"
  />
  <!-- Manija arqueada -->
  <path 
    d="M8.5 8.5V6C8.5 4.1 10.1 2.5 12 2.5C13.9 2.5 15.5 4.1 15.5 6V8.5" 
    stroke="currentColor" 
    stroke-width="1.5" 
    stroke-linecap="round" 
    stroke-opacity="0.6"
  />
  <!-- Chip/Etiqueta Solius con pulso carmesí -->
  <rect x="8.5" y="12" width="7" height="4.5" rx="1.2" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.4" />
  <circle cx="10.5" cy="14.25" r="0.9" fill="#ef4444" />
  <line x1="12.5" y1="14.25" x2="14.5" y2="14.25" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-opacity="0.6" />
  <!-- Línea de corte diagonal sutil -->
  <path d="M17 10L18.5 12.5" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round" />
</svg>
