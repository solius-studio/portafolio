---
interface Props {
  class?: string;
}

const { class: className = "w-6 h-6" } = Astro.props;
---

<svg 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <!-- Núcleo de Procesamiento Central -->
  <rect x="7.5" y="7.5" width="9" height="9" rx="2.5" stroke="currentColor" stroke-width="1.6" stroke-opacity="0.9" fill="currentColor" fill-opacity="0.1" />
  
  <!-- Núcleo Interno Cuántico Rojo -->
  <rect x="9.5" y="9.5" width="5" height="5" rx="1.2" fill="#ef4444" fill-opacity="0.85" />
  <circle cx="12" cy="12" r="1.1" fill="#ffffff" />

  <!-- Pistas Sinápticas Superiores -->
  <path d="M9.5 7.5V3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.7" />
  <path d="M14.5 7.5V3.5" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round" />
  <circle cx="9.5" cy="2.5" r="0.9" fill="currentColor" fill-opacity="0.4" />
  <circle cx="14.5" cy="2.5" r="0.9" fill="#ef4444" />

  <!-- Pistas Sinápticas Inferiores -->
  <path d="M9.5 16.5V20.5" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round" />
  <path d="M14.5 16.5V20.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.7" />
  <circle cx="9.5" cy="21.5" r="0.9" fill="#ef4444" />
  <circle cx="14.5" cy="21.5" r="0.9" fill="currentColor" fill-opacity="0.4" />

  <!-- Pistas Laterales Izquierdas -->
  <path d="M7.5 9.5H3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.7" />
  <path d="M7.5 14.5H3.5" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round" />
  <circle cx="2.5" cy="9.5" r="0.9" fill="currentColor" fill-opacity="0.4" />
  <circle cx="2.5" cy="14.5" r="0.9" fill="#ef4444" />

  <!-- Pistas Laterales Derechas -->
  <path d="M16.5 9.5H20.5" stroke="#ef4444" stroke-width="1.3" stroke-linecap="round" />
  <path d="M16.5 14.5H20.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.7" />
  <circle cx="21.5" cy="9.5" r="0.9" fill="#ef4444" />
  <circle cx="21.5" cy="14.5" r="0.9" fill="currentColor" fill-opacity="0.4" />
</svg>
