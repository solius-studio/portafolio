---
interface Props {
  class?: string;
}

const { class: className = "w-6 h-6" } = Astro.props;
---

<svg 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <rect x="2.5" y="3.5" width="19" height="17" rx="3.5" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.85" />
  <line x1="2.5" y1="8" x2="21.5" y2="8" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.4" />
  <!-- Puntos de la ventana estilo Solius -->
  <circle cx="5.5" cy="5.75" r="1" fill="#ef4444" />
  <circle cx="8.5" cy="5.75" r="1" fill="currentColor" fill-opacity="0.3" />
  <circle cx="11.5" cy="5.75" r="1" fill="currentColor" fill-opacity="0.3" />
  <!-- Layout interno moderno -->
  <rect x="5" y="10.5" width="5.5" height="7.5" rx="1.5" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.5" />
  <line x1="13" y1="11.5" x2="19" y2="11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.7" />
  <line x1="13" y1="14.5" x2="17.5" y2="14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-opacity="0.4" />
  <circle cx="14" cy="17" r="1" fill="#ef4444" />
  <line x1="16.5" y1="17" x2="19" y2="17" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-opacity="0.5" />
</svg>
