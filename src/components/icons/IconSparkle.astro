  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <path 
    d="M12 2L14.2 9.8L22 12L14.2 14.2L12 22L9.8 14.2L2 12L9.8 9.8L12 2Z" 
    stroke="currentColor" 
    stroke-width="1.5" 
    stroke-linejoin="round"
    stroke-opacity="0.9"
    fill="currentColor"
    fill-opacity="0.12"
  />
  <circle cx="12" cy="12" r="1.5" fill="#ef4444" />
</svg>
