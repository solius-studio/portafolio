---
interface Props {
  class?: string;
}

const { class: className = "w-6 h-6" } = Astro.props;
---

<svg 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <!-- Perímetro del escudo -->
  <path 
    d="M12 2.5L4 6V11.5C4 16.5 7.4 21.1 12 22.5C16.6 21.1 20 16.5 20 11.5V6L12 2.5Z" 
    stroke="currentColor" 
    stroke-width="1.6" 
    stroke-linejoin="round"
    stroke-opacity="0.85"
    fill="currentColor"
    fill-opacity="0.06"
  />
  <!-- Faceta interna con brillo rojo -->
  <path 
    d="M12 5.5L6.5 8V11.8C6.5 15.4 8.8 18.8 12 19.9C15.2 18.8 17.5 15.4 17.5 11.8V8L12 5.5Z" 
    stroke="currentColor" 
    stroke-width="1.1" 
    stroke-opacity="0.3" 
  />
  <!-- Check de verificación de seguridad con acento rojo -->
  <path 
    d="M9 12L11 14L15.5 9.5" 
    stroke="#ef4444" 
    stroke-width="1.8" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
  />
</svg>
