---
interface Props {
  class?: string;
}

const { class: className = "w-6 h-6" } = Astro.props;
---

<svg 
  viewBox="0 0 24 24" 
  fill="none" 
  xmlns="http://www.w3.org/2000/svg" 
  class={className}
>
  <!-- Arco del tacómetro -->
  <path 
    d="M4.2 16.5C3.4 15.2 3 13.6 3 12C3 7.03 7.03 3 12 3C16.97 3 21 7.03 21 12C21 13.6 20.6 15.2 19.8 16.5" 
    stroke="currentColor" 
    stroke-width="1.6" 
    stroke-linecap="round" 
    stroke-opacity="0.8" 
  />
  <!-- Segmento de alta velocidad en rojo -->
  <path 
    d="M17.5 5.5C19.2 7.1 20.3 9.4 20.5 12" 
    stroke="#ef4444" 
    stroke-width="2.2" 
    stroke-linecap="round" 
  />
  <!-- Aguja de precisión centrada en rendimiento máximo -->
  <circle cx="12" cy="14" r="2.2" fill="currentColor" fill-opacity="0.9" />
  <circle cx="12" cy="14" r="1.1" fill="#ef4444" />
  <path d="M12 14L16.8 8.2" stroke="#ef4444" stroke-width="1.8" stroke-linecap="round" />
  
  <!-- Marcas de cuadrante -->
  <line x1="6" y1="12" x2="7.5" y2="12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.4" />
  <line x1="12" y1="6" x2="12" y2="7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.4" />
  <line x1="18" y1="12" x2="16.5" y2="12" stroke="#ef4444" stroke-width="1.4" stroke-linecap="round" />
</svg>
