---
import IconAI from './icons/IconAI.astro';
import IconArrowRight from './icons/IconArrowRight.astro';
import IconSparkle from './icons/IconSparkle.astro';
import IconSpeed from './icons/IconSpeed.astro';
---

<section id="simulador-ia" class="py-24 px-4 sm:px-6 lg:px-10 max-w-[1240px] mx-auto border-t border-[#EAEAE4] dark:border-white/10 relative">
  <div class="rounded-3xl border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-[#0E0E12] p-6 sm:p-12 shadow-lg dark:shadow-2xl overflow-hidden relative">
    
    <!-- Aura de fondo sutil -->
    <div class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 bg-[#E58B72]/15 dark:bg-red-600/10 rounded-full blur-3xl"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Izquierda: Explicación y Sliders -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-[#8A3D28] dark:bg-red-500 animate-pulse"></span>
            <span class="text-xs font-mono uppercase tracking-widest text-[#8A3D28] dark:text-red-400 font-semibold">03 // Herramienta Interactiva</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#252A29] dark:text-white tracking-tight">
            Calculá cuánto tiempo y dinero <br class="hidden sm:inline" />
            pierde tu negocio sin automatización.
          </h2>
          <p class="mt-3 text-sm text-[#252A29]/75 dark:text-neutral-400 leading-relaxed">
            Mové los controles interactivos para estimar las horas que podés recuperar al mes implementando un agente de atención inteligente.
          </p>
        </div>

        <!-- Sliders Interactivos -->
        <div class="space-y-6 pt-2">
          
          <!-- Slider 1: Consultas por día -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-semibold text-[#252A29] dark:text-neutral-200">
              <label for="slider-inquiries">Consultas o mensajes diarios por WhatsApp / Web:</label>
              <span id="label-inquiries" class="font-mono text-[#8A3D28] dark:text-red-400 font-bold text-sm">25 msgs/día</span>
            </div>
            <input 
              id="slider-inquiries" 
              type="range" 
              min="5" 
              max="150" 
              step="5" 
              value="25"
              class="w-full h-2 rounded-lg bg-[#EAEAE4] dark:bg-neutral-800 accent-[#8A3D28] dark:accent-red-500 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-[#252A29]/50 dark:text-neutral-500 font-mono">
              <span>5 (Bajo volumen)</span>
              <span>75</span>
              <span>150+ (Alto tráfico)</span>
            </div>
          </div>

          <!-- Slider 2: Minutos dedicados por consulta -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-xs font-semibold text-[#252A29] dark:text-neutral-200">
              <label for="slider-minutes">Tiempo dedicado a responder, calificar o coordinar:</label>
              <span id="label-minutes" class="font-mono text-[#8A3D28] dark:text-red-400 font-bold text-sm">8 minutos</span>
            </div>
            <input 
              id="slider-minutes" 
              type="range" 
              min="3" 
              max="20" 
              step="1" 
              value="8"
              class="w-full h-2 rounded-lg bg-[#EAEAE4] dark:bg-neutral-800 accent-[#8A3D28] dark:accent-red-500 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-[#252A29]/50 dark:text-neutral-500 font-mono">
              <span>3 min (Rápido)</span>
              <span>10 min</span>
              <span>20 min (Complejo)</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Columna Derecha: Tarjeta de Resultados Dinámicos en Tiempo Real -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-[#8A3D28]/30 dark:border-red-500/30 bg-[#F8F8F5] dark:bg-neutral-950 p-6 sm:p-8 space-y-6 shadow-md relative">
          
          <div class="flex items-center justify-between border-b border-[#EAEAE4] dark:border-white/10 pb-4">
            <div class="flex items-center gap-2">
              <IconSpeed class="w-5 h-5 text-[#8A3D28] dark:text-red-500" />
              <span class="text-xs font-mono font-bold uppercase text-[#252A29] dark:text-white">Impacto Comercial Estimado</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-400 font-mono font-semibold">En tiempo real</span>
          </div>

          <!-- Métrica 1: Horas ahorradas al mes -->
          <div class="space-y-1">
            <p class="text-xs text-[#252A29]/70 dark:text-neutral-400 font-medium">Tiempo manual ahorrado al mes:</p>
            <div class="flex items-baseline gap-2">
              <span id="calc-hours" class="text-4xl sm:text-5xl font-black text-[#8A3D28] dark:text-red-500 font-mono">60</span>
              <span class="text-sm font-bold text-[#252A29] dark:text-white uppercase font-mono">horas/mes</span>
            </div>
            <p class="text-[11px] text-[#252A29]/60 dark:text-neutral-400">Equivalente a más de una semana laboral completa de atención al cliente.</p>
          </div>

          <!-- Métrica 2: Aumento en velocidad de respuesta -->
          <div class="p-3.5 rounded-xl bg-white dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/5 space-y-1 text-xs">
            <div class="flex justify-between">
              <span class="text-[#252A29]/70 dark:text-neutral-400">Velocidad con Agente Solius:</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400 font-mono">&lt; 3 segundos</span>
            </div>
            <div class="flex justify-between">
              <span class="text-[#252A29]/70 dark:text-neutral-400">Prospectos rescatados:</span>
              <span id="calc-leads" class="font-bold text-[#252A29] dark:text-white font-mono">+25% de ventas</span>
            </div>
          </div>

          <!-- CTA de la calculadora -->
          <a 
            href="#contacto" 
            class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-full bg-[#8A3D28] dark:bg-red-600 text-white text-xs font-bold tracking-wide hover:bg-[#6E2E1C] dark:hover:bg-red-500 transition-all shadow-md group"
          >
            <span>Quiero este ahorro en mi empresa</span>
            <IconArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const sliderInquiries = document.getElementById('slider-inquiries') as HTMLInputElement | null;
  const sliderMinutes = document.getElementById('slider-minutes') as HTMLInputElement | null;
  const labelInquiries = document.getElementById('label-inquiries');
  const labelMinutes = document.getElementById('label-minutes');
  const calcHours = document.getElementById('calc-hours');
  const calcLeads = document.getElementById('calc-leads');

  function calculateROI() {
    if (!sliderInquiries || !sliderMinutes) return;
    const inquiries = parseInt(sliderInquiries.value, 10);
    const minutes = parseInt(sliderMinutes.value, 10);

    if (labelInquiries) labelInquiries.textContent = `${inquiries} msgs/día`;
    if (labelMinutes) labelMinutes.textContent = `${minutes} minutos`;

    // 25 días hábiles al mes
    const totalMinutesMonthly = inquiries * minutes * 25;
    const totalHours = Math.round(totalMinutesMonthly / 60);

    if (calcHours) calcHours.textContent = String(totalHours);
    if (calcLeads) {
      if (inquiries > 50) {
        calcLeads.textContent = `+35% ventas recuperadas`;
      } else if (inquiries > 20) {
        calcLeads.textContent = `+25% ventas recuperadas`;
      } else {
        calcLeads.textContent = `+15% clientes no perdidos`;
      }
    }
  }

  if (sliderInquiries && sliderMinutes) {
    sliderInquiries.addEventListener('input', calculateROI);
    sliderMinutes.addEventListener('input', calculateROI);
    calculateROI();
  }
</script>
