---
import IconArrowRight from './icons/IconArrowRight.astro';
import IconCheck from './icons/IconCheck.astro';
import IconSparkle from './icons/IconSparkle.astro';
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 px-6 lg:px-10 max-w-[1240px] mx-auto overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    <!-- Columna Izquierda: Mensaje y Titular Expresivo -->
    <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
      
      <!-- Badge de Identidad Cálido / Adaptable -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAEAE4] dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/10 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#E58B72] dark:bg-red-500 animate-pulse"></span>
        <span class="text-xs font-semibold tracking-wide text-[#8A3D28] dark:text-red-400 uppercase font-mono">
          Estudio de Desarrollo Web & Automatización IA
        </span>
      </div>

      <!-- Titular Principal Grande y Expresivo -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#252A29] dark:text-white leading-[1.12]">
        Presencia digital con carácter. <br />
        <span class="text-[#8A3D28] dark:text-transparent dark:bg-clip-text dark:bg-gradient-to-r dark:from-white dark:via-red-400 dark:to-red-600">
          Automatizaciones
        </span> que escalan tu negocio.
      </h1>

      <!-- Descripción Breve y Humana -->
      <p class="mt-6 text-base sm:text-lg text-[#252A29]/80 dark:text-neutral-300 font-normal leading-relaxed max-w-xl">
        Creamos plataformas web ultrarrápidas y agentes inteligentes que responden dudas, filtran prospectos y coordinan turnos las 24 horas. Cero plantillas genéricas, máxima conversión.
      </p>

      <!-- Botones de Acción -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
        <a 
          href="#proyectos" 
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full bg-[#8A3D28] dark:bg-red-600 hover:bg-[#6E2E1C] dark:hover:bg-red-500 text-white font-semibold text-sm transition-all duration-200 shadow-md hover:shadow-lg dark:shadow-[0_0_25px_-5px_rgba(239,68,68,0.5)] group"
        >
          <span>Explorar Showcase y Demos</span>
          <IconArrowRight class="w-4 h-4 text-white group-hover:translate-x-0.5 transition-transform" />
        </a>

        <a 
          href="#simulador-ia" 
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full border border-[#8A3D28]/30 dark:border-white/10 bg-white/70 dark:bg-neutral-900/80 hover:bg-[#EAEAE4] dark:hover:bg-neutral-800 text-[#8A3D28] dark:text-neutral-200 font-semibold text-sm transition-all duration-200"
        >
          <span>Calcular Ahorro con IA</span>
        </a>
      </div>

      <!-- Garantías Comerciales Claras -->
      <div class="mt-12 pt-8 border-t border-[#EAEAE4] dark:border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4 w-full text-xs text-[#252A29]/75 dark:text-neutral-400 font-medium">
        <div class="flex items-center gap-2">
          <IconCheck class="w-4 h-4 text-[#8A3D28] dark:text-red-500 shrink-0" />
          <span>Código 100% propio del cliente</span>
        </div>
        <div class="flex items-center gap-2">
          <IconCheck class="w-4 h-4 text-[#8A3D28] dark:text-red-500 shrink-0" />
          <span>0% comisiones por tus ventas</span>
        </div>
        <div class="flex items-center gap-2">
          <IconCheck class="w-4 h-4 text-[#8A3D28] dark:text-red-500 shrink-0" />
          <span>Entrega funcional en 7 a 10 días</span>
        </div>
      </div>

    </div>

    <!-- Columna Derecha: Composición Gráfica Original de Mockups Editoriales -->
    <div class="lg:col-span-5 w-full relative">
      
      <!-- Fondo decorativo suave -->
      <div class="absolute -inset-2 bg-[#EAEAE4]/70 dark:bg-neutral-900/50 rounded-3xl -rotate-1 pointer-events-none"></div>

      <!-- Ventana Principal del Mockup -->
      <div class="relative rounded-2xl border border-[#EAEAE4] dark:border-white/10 bg-white dark:bg-[#0E0E12] p-5 sm:p-6 shadow-xl dark:shadow-2xl space-y-5">
        
        <!-- Header de la ventana -->
        <div class="flex items-center justify-between border-b border-[#EAEAE4] dark:border-white/10 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#E58B72] dark:bg-red-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#EAEAE4] dark:bg-neutral-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#8A3D28]/30 dark:bg-neutral-800"></span>
            <span class="ml-2 text-xs font-mono text-[#252A29]/60 dark:text-neutral-400">aurabistro.com/menu-qr</span>
          </div>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-[#E58B72]/15 dark:bg-red-950/60 text-[#8A3D28] dark:text-red-400 font-semibold">
            Activo · 0% Comisión
          </span>
        </div>

        <!-- Vista previa de interfaz real -->
        <div class="p-4 rounded-xl bg-[#F8F8F5] dark:bg-neutral-950 border border-[#EAEAE4] dark:border-white/5 space-y-3">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-bold text-[#8A3D28] dark:text-red-400 uppercase tracking-wide font-mono">Aura Bistro & Bar</p>
              <h3 class="text-sm font-bold text-[#252A29] dark:text-white mt-0.5">Menú Digital & Comandas QR</h3>
            </div>
            <span class="text-xs font-mono font-bold text-[#8A3D28] dark:text-emerald-400">0.2s LCP</span>
          </div>
          <p class="text-xs text-[#252A29]/70 dark:text-neutral-400 leading-relaxed">
            Los comensales eligen desde la mesa y el pedido se envía formateado directo al WhatsApp de cocina con el número de mesa.
          </p>
          <div class="flex items-center gap-2 pt-1 text-[11px] font-mono">
            <span class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-neutral-300">Mesa 04</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-neutral-900 border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-neutral-300">2 platos</span>
            <span class="px-2 py-0.5 rounded bg-[#8A3D28] dark:bg-red-600 text-white font-semibold">Enviado</span>
          </div>
        </div>

        <!-- Tarjeta Flotante Superpuesta: Agente Inteligente en Acción -->
        <div class="p-4 rounded-xl border border-[#8A3D28]/20 dark:border-red-500/20 bg-white dark:bg-[#121316] shadow-md space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#8A3D28] dark:bg-red-500"></span>
              <span class="text-xs font-bold text-[#252A29] dark:text-white">Solius AI Coordinator</span>
            </div>
            <span class="text-[10px] font-mono text-[#252A29]/60 dark:text-neutral-400">24/7 en línea</span>
          </div>
          <div class="text-xs text-[#252A29]/80 dark:text-neutral-300 bg-[#F8F8F5] dark:bg-neutral-950 p-2.5 rounded-lg border border-[#EAEAE4]/80 dark:border-white/5">
            <span class="text-[#8A3D28] dark:text-red-400 font-semibold">Triaje Legal:</span> "Consulta sobre contrato comercial calificada con éxito. Turno agendado con el socio para el jueves 16:30 hs."
          </div>
        </div>

        <!-- Telemetría y Métricas Reales -->
        <div class="pt-1 flex items-center justify-between text-xs font-mono text-[#252A29]/70 dark:text-neutral-400 border-t border-[#EAEAE4]/80 dark:border-white/10">
          <span>Google PageSpeed: <strong class="text-[#8A3D28] dark:text-red-400">100/100</strong></span>
          <span>Infraestructura: <strong class="text-[#8A3D28] dark:text-red-400">CDN Edge</strong></span>
        </div>

      </div>

    </div>

  </div>
</section>
