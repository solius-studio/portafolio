---
import IconArrowRight from './icons/IconArrowRight.astro';
import IconMenu from './icons/IconMenu.astro';
import IconClose from './icons/IconClose.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 w-full border-b border-white/[0.06] bg-[#070709]/85 backdrop-blur-xl transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    
    <!-- Identidad de Marca: Sobria, Editorial, Estudio de Alto Nivel -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="flex items-center justify-center w-8 h-8 rounded-md bg-white/[0.04] border border-white/10 group-hover:border-white/30 transition-colors">
        <span class="text-xs font-bold text-white tracking-wider font-mono">S</span>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight text-white group-hover:text-neutral-200 transition-colors">
          Solius Studio
        </span>
        <span class="text-[10px] tracking-widest uppercase text-neutral-400 font-mono">
          Ingeniería Web & IA
        </span>
      </div>
    </a>

    <!-- Navegación Central: Sin modismos tech ni badges artificiales -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-normal text-neutral-300">
      <a href="#servicios" class="hover:text-white transition-colors duration-200">
        Servicios
      </a>
      <a href="#soluciones" class="hover:text-white transition-colors duration-200">
        Soluciones
      </a>
      <a href="#proyectos" class="hover:text-white transition-colors duration-200">
        Portafolio
      </a>
      <a href="#metodo" class="hover:text-white transition-colors duration-200">
        Metodología
      </a>
      <a href="#faq" class="hover:text-white transition-colors duration-200">
        Preguntas Frecuentes
      </a>
    </nav>

    <!-- Acción Comercial Principal: Elegante, Alto Contraste (Blanco sobre Negro) -->
    <div class="flex items-center gap-4">
      <a 
        href="#contacto" 
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-md bg-white text-neutral-950 font-medium text-xs sm:text-sm hover:bg-neutral-200 transition-all duration-200 shadow-sm"
      >
        <span>Iniciar Consulta</span>
        <IconArrowRight class="w-3.5 h-3.5 text-neutral-950" />
      </a>

      <!-- Botón Menú Móvil Limpio -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        aria-label="Abrir menú"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-md border border-white/10 text-neutral-300 hover:text-white hover:bg-white/5 transition-colors"
      >
        <span id="menu-icon-open"><IconMenu class="w-5 h-5" /></span>
        <span id="menu-icon-close" class="hidden"><IconClose class="w-5 h-5" /></span>
      </button>
    </div>
  </div>

  <!-- Menú Desplegable Móvil: Limpio, Editorial y Directo -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden border-t border-white/[0.06] bg-[#070709] px-6 py-6 flex flex-col gap-5 text-sm text-neutral-300"
  >
    <a href="#servicios" class="mobile-nav-link py-1 hover:text-white transition-colors">
      Servicios
    </a>
    <a href="#soluciones" class="mobile-nav-link py-1 hover:text-white transition-colors">
      Soluciones
    </a>
    <a href="#proyectos" class="mobile-nav-link py-1 hover:text-white transition-colors">
      Portafolio
    </a>
    <a href="#metodo" class="mobile-nav-link py-1 hover:text-white transition-colors">
      Metodología
    </a>
    <a href="#faq" class="mobile-nav-link py-1 hover:text-white transition-colors">
      Preguntas Frecuentes
    </a>

    <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
      <a 
        href="#contacto" 
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 rounded-md bg-white text-neutral-950 font-medium text-sm hover:bg-neutral-200 transition-colors"
      >
        <span>Iniciar Consulta</span>
        <IconArrowRight class="w-4 h-4 text-neutral-950" />
      </a>
      <span class="text-xs text-neutral-400 text-center font-mono">
        Atención personalizada para empresas y profesionales
      </span>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && drawer && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isClosed = drawer.classList.contains('hidden');
      if (isClosed) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
