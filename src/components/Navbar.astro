---
import { Sparkles, ArrowRight } from '@lucide/astro';
---

<header class="fixed top-0 left-0 right-0 z-50 flex justify-center px-4 py-4 sm:py-6 transition-all duration-300">
  <nav class="flex items-center justify-between w-full max-w-5xl px-5 py-3 rounded-full bg-neutral-950/75 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/80">
    <!-- Logotipo Solius Studio -->
    <a href="#" class="flex items-center gap-2 group">
      <div class="relative flex items-center justify-center w-7 h-7 rounded-lg bg-neutral-900 border border-white/10 group-hover:border-red-500/50 transition-colors">
        <div class="w-2.5 h-2.5 rounded-full bg-red-600 group-hover:scale-110 transition-transform shadow-[0_0_8px_rgba(239,68,68,0.8)]"></div>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-bold tracking-tight text-white text-base sm:text-lg">SOLIUS</span>
        <span class="text-xs font-medium tracking-widest text-neutral-400 uppercase">STUDIO</span>
      </div>
    </a>

    <!-- Enlaces Desktop -->
    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-400">
      <a href="#servicios" class="hover:text-white transition-colors">Servicios</a>
      <a href="#proyectos" class="hover:text-white transition-colors">Casos de Éxito</a>
      <a href="#ia-automatizacion" class="flex items-center gap-1.5 hover:text-white transition-colors">
        <span>Agentes IA</span>
        <span class="px-1.5 py-0.5 text-[10px] font-semibold text-red-400 bg-red-950/60 border border-red-800/40 rounded-full">Nuevo</span>
      </a>
      <a href="#metodo" class="hover:text-white transition-colors">Metodología</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
    </div>

    <!-- CTA Navbar -->
    <div class="flex items-center gap-3">
      <a 
        href="#contacto" 
        class="group relative inline-flex items-center gap-1.5 px-4 py-2 text-xs sm:text-sm font-medium text-white rounded-full bg-gradient-to-r from-neutral-900 to-neutral-800 border border-white/15 hover:border-red-500/50 transition-all duration-300 hover:shadow-[0_0_20px_-3px_rgba(239,68,68,0.4)]"
      >
        <span>Agendar Consulta</span>
        <ArrowRight class="w-3.5 h-3.5 text-neutral-400 group-hover:text-red-400 group-hover:translate-x-0.5 transition-all" />
      </a>
    </div>
  </nav>
</header>
