---
import IconArrowRight from './icons/IconArrowRight.astro';
import IconMenu from './icons/IconMenu.astro';
import IconClose from './icons/IconClose.astro';
import IconSun from './icons/IconSun.astro';
import IconMoon from './icons/IconMoon.astro';

const links = [
  { label: "Servicios", href: "#servicios" },
  { label: "Showcase", href: "#proyectos" },
  { label: "Simulador ROI", href: "#simulador-ia" },
  { label: "Agentes IA", href: "#ia-automatizacion" },
  { label: "Método", href: "#metodo" },
  { label: "FAQ", href: "#faq" },
];
---

<header class="fixed top-0 inset-x-0 z-50 h-20 border-b border-[#EAEAE4] dark:border-white/10 bg-[#F8F8F5]/85 dark:bg-[#070709]/85 backdrop-blur-xl transition-all duration-300">
  <div class="max-w-[1240px] mx-auto h-full px-6 lg:px-10 flex items-center justify-between">
    
    <!-- Logotipo Solius Studio -->
    <a href="#" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-[#8A3D28] dark:bg-red-600 flex items-center justify-center text-white font-bold text-sm tracking-tight transition-transform group-hover:scale-105 duration-200 shadow-sm dark:shadow-[0_0_15px_rgba(239,68,68,0.5)]">
        S
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-bold text-lg tracking-tight text-[#252A29] dark:text-white group-hover:text-[#8A3D28] dark:group-hover:text-red-400 transition-colors">
          Solius Studio
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#E58B72] dark:bg-red-500 animate-pulse"></span>
      </div>
    </a>

    <!-- Enlaces Principales Desktop -->
    <nav class="hidden md:flex items-center gap-7 text-[14px] font-medium text-[#252A29]/75 dark:text-neutral-400">
      {links.map(link => (
        <a 
          href={link.href} 
          class="hover:text-[#8A3D28] dark:hover:text-white transition-colors duration-150 relative py-1"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Controles: Theme Switcher + CTA + Menú Móvil -->
    <div class="flex items-center gap-3">
      
      <!-- Theme Switcher Button -->
      <button 
        id="theme-toggle"
        type="button" 
        aria-label="Alternar modo claro u oscuro"
        class="flex items-center justify-center w-9 h-9 rounded-full border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-neutral-300 hover:bg-[#EAEAE4]/50 dark:hover:bg-neutral-800 transition-all duration-200 shadow-sm"
        title="Cambiar tema (Claro / Oscuro)"
      >
        <span id="theme-sun-icon" class="dark:hidden"><IconMoon class="w-4 h-4 text-[#8A3D28]" /></span>
        <span id="theme-moon-icon" class="hidden dark:inline"><IconSun class="w-4 h-4 text-red-400" /></span>
      </button>

      <!-- Botón de Contacto Desktop -->
      <a 
        href="#contacto" 
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#8A3D28] dark:bg-red-600 text-white text-[13px] font-semibold hover:bg-[#6E2E1C] dark:hover:bg-red-500 transition-all duration-200 shadow-sm hover:shadow dark:shadow-[0_0_20px_-3px_rgba(239,68,68,0.5)]"
      >
        <span>Iniciar Proyecto</span>
        <IconArrowRight class="w-3.5 h-3.5 text-white/90" />
      </a>

      <!-- Botón Hamburguesa Móvil -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        aria-label="Abrir menú"
        class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg border border-[#EAEAE4] dark:border-white/10 text-[#252A29] dark:text-white hover:bg-[#EAEAE4]/50 dark:hover:bg-white/5 transition-colors"
      >
        <span id="menu-icon-open"><IconMenu class="w-5 h-5" /></span>
        <span id="menu-icon-close" class="hidden"><IconClose class="w-5 h-5" /></span>
      </button>
    </div>
  </div>

  <!-- Panel Desplegable Móvil -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden border-t border-[#EAEAE4] dark:border-white/10 bg-[#F8F8F5] dark:bg-[#070709] px-6 py-6 flex flex-col gap-4 shadow-xl"
  >
    {links.map(link => (
      <a 
        href={link.href} 
        class="mobile-nav-link text-[15px] font-medium text-[#252A29] dark:text-neutral-200 hover:text-[#8A3D28] dark:hover:text-red-400 py-2 border-b border-[#EAEAE4]/60 dark:border-white/5 transition-colors"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-3">
      <a 
        href="#contacto" 
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 rounded-full bg-[#8A3D28] dark:bg-red-600 text-white text-sm font-semibold hover:bg-[#6E2E1C] dark:hover:bg-red-500 transition-colors shadow-md"
      >
        <span>Iniciar Proyecto</span>
        <IconArrowRight class="w-4 h-4 text-white" />
      </a>
    </div>
  </div>
</header>

<script>
  // Manejo del Theme Switcher
  const themeToggle = document.getElementById('theme-toggle');
  
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('solius-theme', isDark ? 'dark' : 'light');
    });
  }

  // Manejo del Menú Móvil
  const menuBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuBtn && drawer && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      drawer.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
