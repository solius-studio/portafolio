---
import IconArrowRight from './icons/IconArrowRight.astro';
---

<section id="contacto" class="py-24 px-6 border-t border-white/[0.06]">
  <div class="max-w-[1200px] mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      
      <!-- Lado Izquierdo: Mensaje Institucional -->
      <div>
        <p class="text-[13px] text-neutral-500 mb-3 font-mono tracking-wide">Contacto directo</p>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3rem)] font-bold tracking-[-0.035em] text-white leading-[1.1] mb-6">
          Hablemos de tu proyecto.
        </h2>
        <p class="text-[15px] text-neutral-400 leading-relaxed mb-8 max-w-md">
          Analizamos la situación de tu negocio y te explicamos con honestidad si tiene sentido implementar una web a medida, un agente de IA o ambos.
        </p>

        <div class="space-y-4 pt-6 border-t border-white/[0.06] text-[13px] text-neutral-400 font-mono">
          <div class="flex items-center gap-3">
            <span class="text-[#e54d2e]">—</span>
            <span>Presupuesto claro y cerrado, sin costos adicionales.</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#e54d2e]">—</span>
            <span>Código de tu propiedad. Sin tarifas de alquiler.</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[#e54d2e]">—</span>
            <span>Respuesta en menos de dos horas hábiles.</span>
          </div>
        </div>
      </div>

      <!-- Lado Derecho: Formulario Sobrio -->
      <div class="bg-[#0a0a0c] border border-white/[0.08] rounded-lg p-8 sm:p-10">
        <form class="space-y-5" onsubmit="event.preventDefault();">
          <div>
            <label class="block text-[12px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
              Nombre o Empresa
            </label>
            <input 
              type="text" 
              required
              placeholder="Ej. Estudio Jurídico Rossi" 
              class="w-full px-4 py-3 bg-[#050505] border border-white/[0.08] rounded-md text-white text-[14px] placeholder-neutral-600 focus:outline-none focus:border-white/30 transition-colors duration-150"
            />
          </div>

          <div>
            <label class="block text-[12px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
              Sector del Negocio
            </label>
            <select class="w-full px-4 py-3 bg-[#050505] border border-white/[0.08] rounded-md text-neutral-300 text-[14px] focus:outline-none focus:border-white/30 transition-colors duration-150">
              <option value="comercio">Comercio Local / Gastronomía</option>
              <option value="juridico">Estudio Jurídico o Contable</option>
              <option value="ecommerce">Tienda Online / E-commerce</option>
              <option value="ia">Automatización de Procesos con IA</option>
              <option value="otro">Otro proyecto a medida</option>
            </select>
          </div>

          <div>
            <label class="block text-[12px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
              WhatsApp o Correo de Contacto
            </label>
            <input 
              type="text" 
              required
              placeholder="+54 9 11 ..." 
              class="w-full px-4 py-3 bg-[#050505] border border-white/[0.08] rounded-md text-white text-[14px] placeholder-neutral-600 focus:outline-none focus:border-white/30 transition-colors duration-150"
            />
          </div>

          <div>
            <label class="block text-[12px] font-mono uppercase tracking-wider text-neutral-400 mb-2">
              Breve descripción del objetivo (opcional)
            </label>
            <textarea 
              rows="3"
              placeholder="¿Qué problema buscas resolver o qué querés automatizar?" 
              class="w-full px-4 py-3 bg-[#050505] border border-white/[0.08] rounded-md text-white text-[14px] placeholder-neutral-600 focus:outline-none focus:border-white/30 transition-colors duration-150 resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-3.5 px-6 bg-white text-[#050505] rounded-md text-[14px] font-medium hover:bg-neutral-200 transition-colors duration-150 flex items-center justify-center gap-2 group cursor-pointer"
          >
            <span>Solicitar Diagnóstico Sin Costo</span>
            <IconArrowRight class="w-4 h-4 text-[#050505] group-hover:translate-x-0.5 transition-transform duration-150" />
          </button>
        </form>
      </div>

    </div>
  </div>
</section>
