---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Solius Studio — Diseño Web & Automatizaciones Inteligentes",
  description = "Estudio independiente de desarrollo web y automatización con IA. Creamos plataformas con identidad propia, veloces y orientadas a resultados comerciales reales."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//', '/')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts: Manrope & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#F7F7F2] text-[#252A29] antialiased selection:bg-[#E58B72]/30 selection:text-[#252A29]">
    <slot />
  </body>
</html>
